        /* Dynamic Country Grid with Flag Colors */
        .country-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; }
        .country-card { overflow: hidden; position: relative; display: flex; flex-direction: column; height: 100%; }
