        .flag-spain .s1 { background: #AA1521; flex: 1; } .flag-spain .s2 { background: #FFC400; flex: 2; } .flag-spain .s3 { background: #AA1521; flex: 1; }
        .flag-germany .s1 { background: #000000; flex: 1; } .flag-germany .s2 { background: #DD0000; flex: 1; } .flag-germany .s3 { background: #FFCE00; flex: 1; }
        .flag-malta .s1 { background: #FFFFFF; flex: 1; border-right: 1px solid #ccc; } .flag-malta .s2 { background: #D21034; flex: 1; }
        .flag-poland .s1 { background: #FFFFFF; flex: 1; } .flag-poland .s2 { background: #DC143C; flex: 1; }
        .flag-switzerland .s1 { background: #DA291C; flex: 1; position: relative; }
        .flag-nz .s1 { background: #00247D; flex: 3; } .flag-nz .s2 { background: #FFFFFF; flex: 0.2; } .flag-nz .s3 { background: #CC142B; flex: 1; }
        .flag-skorea .s1 { background: #FFFFFF; flex: 2; } .flag-skorea .s2 { background: #CD2E3A; flex: 1; } .flag-skorea .s3 { background: #0047A0; flex: 1; }
        .flag-georgia .s1 { background: #FFFFFF; flex: 2; } .flag-georgia .s2 { background: #FF0000; flex: 1; }
        .flag-finland .s1 { background: #FFFFFF; flex: 1; } .flag-finland .s2 { background: #003580; flex: 1; }
        .flag-france .s1 { background: #0055A4; flex: 1; } .flag-france .s2 { background: #FFFFFF; flex: 1; } .flag-france .s3 { background: #EF4135; flex: 1; }

        .country-img-container { height: 180px; position: relative; overflow: hidden; background: #e2e8f0; }
