        .stat-item h3 { font-size: 3rem; font-weight: 800; color: #FFC107; margin-bottom: 0.5rem; }
        .stat-item p { font-size: 1rem; color: #94a3b8; }

        /* Structured Comparison Table */
        .comparison-wrapper { overflow-x: auto; margin: 3rem 0; border-radius: 16px; box-shadow: var(--shadow); }
        .comp-table { width: 100%; border-collapse: collapse; text-align: left; background: var(--card-bg); min-width: 800px; }
        .comp-table th, .comp-table td { padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--card-border); }
        .comp-table th { background: #003366; color: white; font-weight: 600; }
        .comp-table tr:hover { background: var(--glass-glow); }

        /* FAQ Accordion Section */
        .faq-container { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem; }
        .faq-item { border-radius: 12px; overflow: hidden; }
        .faq-trigger { width: 100%; text-align: left; padding: 1.5rem; background: var(--card-bg); border: none; font-size: 1.1rem; font-weight: 600; color: var(--text-main); display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
