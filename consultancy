        /* Premium Process Timeline Layout */
        .timeline { position: relative; max-width: 900px; margin: 0 auto; padding: 2rem 0; }
        .timeline::before { content: ''; position: absolute; left: 50%; width: 4px; background: linear-gradient(to bottom, #003366, #5E3BEE); top: 0; bottom: 0; transform: translateX(-50%); border-radius: 4px; }
        .timeline-item { position: relative; width: 50%; padding: 2rem; box-sizing: border-box; }
        .timeline-item:nth-child(odd) { left: 0; text-align: right; }
        .timeline-item:nth-child(even) { left: 50%; text-align: left; }
        .timeline-dot { position: absolute; top: 2.5rem; width: 20px; height: 20px; background: #FFC107; border: 4px solid var(--card-bg); border-radius: 50%; z-index: 10; }
        .timeline-item:nth-child(odd) .timeline-dot { right: -10px; }
        .timeline-item:nth-child(even) .timeline-dot { left: -10px; }
        .timeline-content h3 { font-size: 1.3rem; margin-bottom: 0.5rem; color: #5E3BEE; }

        /* Counter Statistics */
        .stats-bar { background: linear-gradient(135deg, #003366 0%, #0f172a 100%); color: white; padding: 4rem 2rem; margin: 4rem 0; }
