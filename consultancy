                        <button class="btn-premium" style="padding:0.4rem 0.8rem; font-size:0.8rem; background:#ea4335; color:white;" onclick="deleteUniStateNode('${u.id}')"><i class="fa-solid fa-trash"></i></button>
                    </td>
                `;
                target.appendChild(tr);
            });
        }

        /* Database Shared Realtime Synchronized Mutation Functions (No-Redeployment Sync Effect) */
        function toggleCountryStateNode(id) {
            const index = localStateDB.countries.findIndex(c => c.id === id);
            if(index !== -1) {
                localStateDB.countries[index].enabled = !localStateDB.countries[index].enabled;
                renderAdminCountryControlRows();
                renderPublicCountryGridCanvas(); // Instant automatic propagation without code changes
            }
        }
        function deleteCountryStateNode(id) {
            if(confirm("Confirm action: Permanently drop this country node configuration from the public web client database?")) {
                localStateDB.countries = localStateDB.countries.filter(c => c.id !== id);
                renderAdminCountryControlRows();
                renderPublicCountryGridCanvas();
            }
        }

        function toggleUniStateNode(id) {
            const index = localStateDB.universities.findIndex(u => u.id === id);
            if(index !== -1) {
                localStateDB.universities[index].enabled = !localStateDB.universities[index].enabled;
                renderAdminUniversityControlRows();
            }
        }
        function deleteUniStateNode(id) {
            if(confirm("Confirm action: Clear this university profile and all associated unlimited courses parameters instantly?")) {
                localStateDB.universities = localStateDB.universities.filter(u => u.id !== id);
                renderAdminUniversityControlRows();
            }
        }

        function launchAddCountryLogic() {
            const name = prompt("Enter Country Name:");
            if(!name) return;
            const flag = prompt("Enter Flag Emoji:");
            const desc = prompt("Provide Short Country Overview Narrative:");
            
            const newId = name.toLowerCase().replace(/\s+/g, '-');
            localStateDB.countries.push({
                id: newId, name: name, flag: flag || "🌐", cssClass: "flag-france", desc: desc || "Premium global academic study tract option with robust market placement options.", enabled: true
            });
            initAdminDashboardViewNode();
            renderPublicCountryGridCanvas();
        }

        function launchAddUniLogic() {
            const name = prompt("Enter University Profile Name:");
            if(!name) return;
            const city = prompt("City Location:");
            const type = confirm("Click OK for Public Sector System, Cancel for Private Institutional Ecosystem") ? "Public" : "Private";
            
            localStateDB.universities.push({
                id: "uni-" + Date.now(), name: name, city: city || "Global Campus Hub", type: type, enabled: true, description: "Newly synched institution profile mapping comprehensive international student streams.", courses: "Multi-Disciplinary Specializations", dead: "Admissions Active"
            });
            initAdminDashboardViewNode();
        }

