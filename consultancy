        /* Employee Admin Dashboard Control Core Panel Logic Engine */
        function switchDashboardTab(tabTargetId) {
            document.querySelectorAll(".dash-panel-node").forEach(node => node.style.display = "none");
            document.querySelectorAll(".portal-nav-btn").forEach(btn => btn.classList.remove("active"));
            
            if(tabTargetId === 'countries') {
                document.getElementById("dash-panel-countries").style.display = "block";
                event.currentTarget.classList.add("active");
            } else {
                document.getElementById("dash-panel-universities").style.display = "block";
                event.currentTarget.classList.add("active");
            }
        }

        function initAdminDashboardViewNode() {
            renderAdminCountryControlRows();
            renderAdminUniversityControlRows();
        }

        function renderAdminCountryControlRows() {
            const target = document.getElementById("admin-country-rows-target");
            target.innerHTML = "";
            localStateDB.countries.forEach(c => {
                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td><strong>${c.name}</strong></td>
                    <td><span style="font-size:1.4rem;">${c.flag}</span></td>
                    <td><span style="color:${c.enabled ? '#25D366' : '#ea4335'}; font-weight:700;">${c.enabled ? 'Live on Site' : 'Disabled'}</span></td>
                    <td>
                        <button class="btn-premium" style="padding:0.4rem 0.8rem; font-size:0.8rem; background:#475569; color:white;" onclick="toggleCountryStateNode('${c.id}')">Toggle Status</button>
                        <button class="btn-premium" style="padding:0.4rem 0.8rem; font-size:0.8rem; background:#ea4335; color:white;" onclick="deleteCountryStateNode('${c.id}')"><i class="fa-solid fa-trash"></i></button>
