            localStateDB.universities.forEach(u => {
                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td><strong>${u.name}</strong><br><small style="color:gray;">${u.description}</small></td>
                    <td>${u.city}</td>
                    <td><span class="btn-premium" style="padding:0.2rem 0.5rem; font-size:0.75rem; background:rgba(94,59,238,0.1); color:#5E3BEE;">${u.type}</span></td>
