        .footer-bottom { max-width: 1400px; margin: 4rem auto 0; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.05); text-align: center; font-size: 0.9rem; }

        /* Dedicated Modal Forms & Dynamic Portals */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px); display: none; align-items: center; justify-content: center; z-index: 10000; padding: 1rem; }
        .auth-container { max-width: 450px; width: 100%; padding: 3rem 2.5rem; position: relative; }
        .close-modal-btn { position: absolute; top: 1.5rem; right: 1.5rem; background: none; border: none; font-size: 1.5rem; color: var(--text-muted); cursor: pointer; }

        /* Employee Live Sync Dashboard view styling */
        .portal-layout { width: 100%; max-width: 1200px; height: 85vh; display: grid; grid-template-columns: 260px 1fr; background: var(--bg-gradient); border-radius: 20px; overflow: hidden; box-shadow: var(--shadow); border: 1px solid var(--card-border); }
        .portal-sidebar { background: #0f172a; color: white; padding: 2rem; display: flex; flex-direction: column; gap: 2rem; }
        .portal-nav-btn { background: none; border: none; color: #94a3b8; padding: 0.8rem 1rem; text-align: left; font-size: 1rem; cursor: pointer; display: flex; align-items: center; gap: 10px; border-radius: 8px; transition: all 0.3s; }
