        .portal-main-view { padding: 2.5rem; overflow-y: auto; background: var(--card-bg); color: var(--text-main); }
        .portal-data-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
        .data-table-admin { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        .data-table-admin th, .data-table-admin td { padding: 1rem; border-bottom: 1px solid var(--card-border); text-align: left; }
        .data-table-admin th { background: rgba(0,0,0,0.05); font-weight: 600; }
        
        /* Keyframe Micro-animations */
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* Media Queries across viewports */
        @media (max-width: 1024px) {
            .timeline::before { left: 20px; }
            .timeline-item { width: 100%; padding-left: 50px; text-align: left !important; }
            .timeline-dot { left: 10px !important; }
            .contact-grid { grid-template-columns: 1fr; }
            .footer-grid { grid-template-columns: 1fr 1fr; }
        }
        @media (max-width: 768px) {
            .nav-menu { display: none; }
            .hero-content h1 { font-size: 2.5rem; }
            .footer-grid { grid-template-columns: 1fr; }
            .portal-layout { grid-template-columns: 1fr; height: 95vh; }
            .portal-sidebar { display: none; }
        }
    </style>
</head>
